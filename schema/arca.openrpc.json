    {
      "name": "watch_report",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "properties": {
            "at": {
              "type": "integer"
            },
            "drift": {
              "items": {
                "properties": {
                  "entry": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "markedWithoutEntry",
                      "entryWithoutObject"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "project": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "entry"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "projects": {
              "items": {
                "properties": {
                  "instances": {
                    "items": {
                      "properties": {
                        "configHash": {
                          "maxLength": 64,
                          "minLength": 64,
                          "type": "string"
                        },
                        "identity": {
                          "type": "boolean"
                        },
                        "kind": {
                          "enum": [
                            "container",
                            "virtual-machine"
                          ],
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "owner": {
                          "properties": {
                            "class": {
                              "enum": [
                                "droidd",
                                "foreign",
                                "kernel",
                                "retained",
                                "contested"
                              ],
                              "type": "string"
                            },
                            "entry": {
                              "type": "string"
                            },
                            "plan": {
                              "maxLength": 64,
                              "minLength": 64,
                              "type": "string"
                            },
                            "plugin": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "class"
                          ],
                          "type": "object"
                        },
                        "privileged": {
                          "type": "boolean"
                        },
                        "status": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "kind",
                        "status",
                        "owner",
                        "privileged",
                        "identity",
                        "configHash"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "project": {
                    "type": "string"
                  }
                },
                "required": [
                  "project",
                  "instances"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "at",
            "projects",
            "drift"
          ],
          "type": "object"
        }
      },
      "summary": "Every instance in every project with its ownership class, and the drift between marks and desired state.",
      "x-arca-additional-properties": true,
      "x-arca-class": "L",
      "x-arca-scope": "viewer",
      "x-arca-writes": false
    },
    {
      "name": "token_list",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "properties": {
            "tokens": {
              "items": {
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "scope": {
                    "enum": [
                      "viewer",
                      "doctor",
                      "operator"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "scope"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "tokens"
          ],
          "type": "object"
        }
      },
      "summary": "The interim API tokens by id and scope. Never a secret or a hash.",
      "x-arca-additional-properties": true,
      "x-arca-class": "L",
      "x-arca-scope": "operator",
      "x-arca-writes": false
    }
  ],
  "openrpc": "1.3.2"
}
