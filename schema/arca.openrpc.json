  "methods": [
    {
      "name": "arca_status",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "properties": {
            "appliedSeq": {
              "type": [
                "integer",
                "null"
              ]
            },
            "incusReachable": {
              "type": "boolean"
            },
            "mode": {
              "enum": [
                "watch-only",
                "kernel"
              ],
              "type": "string"
            },
            "node": {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            "uptimeS": {
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "node",
            "mode",
            "uptimeS",
            "incusReachable",
            "appliedSeq"
          ],
          "type": "object"
        }
      },
      "summary": "Node status: the API version, the node id, the mode, the uptime, whether Incus answers and the last applied sequence number.",
      "x-arca-additional-properties": true,
      "x-arca-class": "L",
      "x-arca-scope": "viewer",
      "x-arca-writes": false
    },
