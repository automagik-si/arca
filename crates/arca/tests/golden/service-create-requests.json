{
  "c1": {
    "config": {
      "boot.autostart": "true",
      "environment.MODE": "plain",
      "environment.URL": "http://192.0.2.10:8080/c1",
      "limits.cpu": "1",
      "limits.memory": "1GiB",
      "oci.entrypoint": "/bin/server --port 8080",
      "user.arca.address": "192.0.2.10",
      "user.arca.envkeys": "MODE,URL",
      "user.arca.ports": "8080",
      "user.arca.template": "oci",
      "user.arcakernel.entry": "service-c1"
    },
    "devices": {
      "eth0": {
        "ipv4.address": "192.0.2.10",
        "name": "eth0",
        "network": "arcak-svcbr",
        "security.acls": "arcak-svc-svc-c1",
        "security.acls.default.egress.action": "reject",
        "security.acls.default.ingress.action": "reject",
        "security.ipv4_filtering": "true",
        "security.mac_filtering": "true",
        "security.port_isolation": "false",
        "type": "nic"
      },
      "root": {
        "path": "/",
        "pool": "pool1",
        "type": "disk"
      },
      "web": {
        "connect": "tcp:127.0.0.1:8080",
        "listen": "tcp:0.0.0.0:8080",
        "type": "proxy"
      }
    },
    "name": "c1",
    "profiles": [
      "arca-service"
    ],
    "source": {
      "alias": "library/example@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "mode": "pull",
      "protocol": "oci",
